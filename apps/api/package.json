{
  "name": "@kalou/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./domain": "./src/domain/index.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@kalou/db": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@kalou/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "~6.0.3"
  }
}
