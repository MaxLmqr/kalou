# Postgres — utilisé par apps/api et packages/db
DATABASE_URL="postgres://postgres:postgres@localhost:5432/kalou"

# API
PORT=3000

# Auth
BETTER_AUTH_SECRET="à générer : openssl rand -hex 32"
BETTER_AUTH_URL="http://localhost:3000"

# Raccourci de développement (doc 06 § 2).
#
# Renseignée, cette variable fait de sa valeur LE code de connexion : n'importe
# quelle adresse se connecte avec, et le compte est créé au passage. C'est ce qui
# permet de se connecter sans service d'envoi d'e-mails.
#
# Ce n'est pas un mode d'authentification : c'est une porte ouverte à quiconque
# joint l'API. L'API refuse de démarrer si elle est renseignée avec
# NODE_ENV=production, et chaque connexion par ce chemin est journalisée.
#
# Laisser vide pour revenir au code aléatoire à six chiffres, affiché dans la
# console du serveur.
AUTH_DEV_OTP="000000"
